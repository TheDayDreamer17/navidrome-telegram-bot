# ==========================================
# Telegram Bot & Navidrome Integration Configuration
# ==========================================

# 1. Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Authorized Users and their download directories inside the container
# Format: TELEGRAM_USER_ID:CONTAINER_DOWNLOAD_PATH (separated by commas for multiple users)
# Example: 12345678:/music/user1/downloads,87654321:/music/user2/downloads
ALLOWED_USERS=12345678:/music/user1/downloads

# 3. Navidrome SQLite database path (mounted inside the container)
NAVIDROME_DB_PATH=/navidrome_data/navidrome.db

# 4. Storage cleanup threshold (days before unplayed songs in downloads/ are flagged for cleanup)
UNPLAYED_EXPIRY_DAYS=14

# 5. Background scheduler interval in seconds (86400 = 24 hours)
DAILY_INTERVAL_SECONDS=86400

# 6. Host volume mounts (used by docker-compose.yml)
MUSIC_ROOT_DIR=${HOME}/Music
NAVIDROME_DATA_DIR=../navidrome/data
